 },
 {
  "id": "mm_001",
  "who": "mm",
  "speaker": "М.М.",
  "mission": "Логово Пацанов",
  "text": "Френчи, гранаты! Работаем!",
  "say": "Френчи, гранаты! Работаем!",
  "note": "",
  "audio": false
 },
 {
  "id": "sl_001",
  "who": "sl",
  "speaker": "Старлайт",
  "mission": "Логово Пацанов",
  "text": "Хватит! Я не дам тебе их тронуть!",
  "say": "Хватит! Я не дам тебе их тронуть!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_022",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Логово Пацанов",
  "text": "Старлайт. Ты всегда была моей любимой разочаровывающей сотрудницей.",
  "say": "Старлайт. Ты всегда была моей любимой разочаровывающей сотрудницей.",
  "note": "",
  "audio": false
 },
 {
  "id": "sl_002",
  "who": "sl",
  "speaker": "Старлайт",
  "mission": "Логово Пацанов",
  "text": "…беги, Хьюи…",
  "say": "…беги, Хьюи…",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_023",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Логово Пацанов",
  "text": "Хьюи? Я слышу твоё сердце, Хьюи. Оно так быстро стучит.",
  "say": "Хьюи? Я слышу твоё сердце, Хьюи. Оно так быстро стучит.",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_001",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Логово Пацанов",
  "text": "Н-не убивай! Пожалуйста! Я… я всё скажу!",
  "say": "Н-не убивай! Пожалуйста! Я… я всё скажу!",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_002",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Логово Пацанов",
  "text": "Бутчер хочет разбудить Солдатика! Его тело держат в лаборатории Vought!",
  "say": "Бутчер хочет разбудить Солдатика! Его тело держат в лаборатории Vought!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_024",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Логово Пацанов",
  "text": "Солдатик мёртв уже сорок лет.",
  "say": "Солдатик мёртв уже сорок лет.",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_003",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Логово Пацанов",
  "text": "Н-не совсем…",
  "say": "Н-не совсем…",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_001",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Солдатик",
  "text": "Так вот ты какой… Моя дешёвая копия.",
  "say": "Так вот ты какой… Моя дешёвая копия.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_025",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Солдатик",
  "text": "Нет. Я — улучшенная версия.",
  "say": "Нет. Я — улучшенная версия.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_002",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Солдатик",
  "text": "Посмотрим, сынок. Меня они тоже пытались похоронить. Не вышло.",
  "say": "Посмотрим, сынок. Меня они тоже пытались похоронить. Не вышло.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_003",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Солдатик",
  "text": "Кх… Погоди. Эти глаза…",
  "say": "Кх… Погоди. Эти глаза…",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_004",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Солдатик",
  "text": "Ты… ты мой сын?",
  "say": "Ты… ты мой сын?",
  "note": "",
  "audio": false
 },
 {
  "id": "but_005",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Солдатик",
  "text": "*по рации* Спасибо за помощь, приятель. Его кровь — всё, что мне было нужно.",
  "say": "Спасибо за помощь, приятель. Его кровь — всё, что мне было нужно.",
  "note": "по рации",
  "audio": false
 },
 {
  "id": "but_006",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Солдатик",
  "text": "Темп-V. Сутки силы, как у вас, уродов. Скоро увидимся, дорогуша.",
  "say": "Темп-V. Сутки силы, как у вас, уродов. Скоро увидимся, дорогуша.",
  "note": "",
  "audio": false
 },
 {
  "id": "crowd_004",
  "who": "crowd",
  "speaker": "Толпа",
  "mission": "Митинг",
  "text": "ХО-УМ-ЛЕН-ДЕР! ХО-УМ-ЛЕН-ДЕР!",
  "say": "ХО-УМ-ЛЕН-ДЕР! ХО-УМ-ЛЕН-ДЕР!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_026",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "Они говорят, что я опасен.",
  "say": "Они говорят, что я опасен.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_027",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "Что я угроза. Что меня нужно остановить.",
  "say": "Что я угроза. Что меня нужно остановить.",
  "note": "",
  "audio": false
 },
 {
  "id": "crowd_005",
  "who": "crowd",
  "speaker": "Толпа",
  "mission": "Митинг",
  "text": "У-у-у!",
  "say": "У-у-у!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_028",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "Но знаете что? Я — единственное, что стоит между вами и хаосом.",
  "say": "Но знаете что? Я — единственное, что стоит между вами и хаосом.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_029",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "Я не ваш слуга. Я — ваш защитник. Я — ваш Хоумлендер!",
  "say": "Я не ваш слуга. Я — ваш защитник. Я — ваш Хоумлендер!",
  "note": "",
  "audio": false
 },
 {
  "id": "prot_001",
  "who": "prot",
  "speaker": "Протестующий",
  "mission": "Митинг",
  "text": "Ты убийца! Сколько ещё людей ты бросишь умирать?!",
  "say": "Ты убийца! Сколько ещё людей ты бросишь умирать?!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_030",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "…Свобода слова. Пусть говорит.",
  "say": "…Свобода слова. Пусть говорит.",
  "note": "",
  "audio": false
 },
 {
  "id": "ash_013",
  "who": "ash",
  "speaker": "Эшли (Vought)",
  "mission": "Митинг",
  "text": "*по рации* О боже… Они… они аплодируют?",
  "say": "О боже… Они… они аплодируют?",
  "note": "по рации",
  "audio": false
 },
 {
  "id": "crowd_006",
  "who": "crowd",
  "speaker": "Толпа",
  "mission": "Митинг",
  "text": "А-а-а! Бегите!",
  "say": "А-а-а! Бегите!",
  "note": "",
  "audio": false
 },
 {
  "id": "crowd_007",
  "who": "crowd",
  "speaker": "Толпа",
  "mission": "Митинг",
  "text": "ХО-УМ-ЛЕН-ДЕР!",
  "say": "ХО-УМ-ЛЕН-ДЕР!",
  "note": "",
  "audio": false
 },
 {
  "id": "ash_014",
  "who": "ash",
  "speaker": "Эшли (Vought)",
  "mission": "Митинг",
  "text": "*по рации* Рейтинг одобрения… девяносто три процента. Это рекорд.",
  "say": "Рейтинг одобрения… девяносто три процента. Это рекорд.",
  "note": "по рации",
  "audio": false
 },
 {
  "id": "hl_031",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Митинг",
  "text": "Конечно рекорд.",
  "say": "Конечно рекорд.",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_007",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "Джон. Хватит.",
  "say": "Джон. Хватит.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_032",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Королева Мейв",
  "text": "Мейв. Пришла читать мне мораль?",
  "say": "Мейв. Пришла читать мне мораль?",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_008",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "Я пришла тебя остановить. Ты убиваешь людей. Больше никто не будет молчать.",
  "say": "Я пришла тебя остановить. Ты убиваешь людей. Больше никто не будет молчать.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_033",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Королева Мейв",
  "text": "*смеётся* Ты? Меня? Ты всегда была просто красивой картинкой на коробке хлопьев.",
  "say": "Ты? Меня? Ты всегда была просто красивой картинкой на коробке хлопьев.",
  "note": "смеётся",
  "audio": false
 },
 {
  "id": "mv_009",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "Тогда тебе нечего бояться.",
  "say": "Тогда тебе нечего бояться.",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_010",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "*вытирает кровь с губы* И это всё, на что ты способен?",
  "say": "И это всё, на что ты способен?",
  "note": "вытирает кровь с губы",
  "audio": false
 },
 {
  "id": "hl_034",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Королева Мейв",
  "text": "Я только разогреваюсь.",
  "say": "Я только разогреваюсь.",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_011",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "А-А-А-А!",
  "say": "А-А-А-А!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_035",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Королева Мейв",
  "text": "Ты сумасшедшая!",
  "say": "Ты сумасшедшая!",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_012",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "Ты даже не представляешь.",
  "say": "Ты даже не представляешь.",
  "note": "",
  "audio": false
 },
 {
  "id": "mv_013",
  "who": "mv",
  "speaker": "Королева Мейв",
  "mission": "Королева Мейв",
  "text": "Давай. Пусть все увидят, кто ты на самом деле.",
  "say": "Давай. Пусть все увидят, кто ты на самом деле.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_036",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Королева Мейв",
  "text": "*опускает кулак и улыбается в камеру* …Не сегодня.",
  "say": "…Не сегодня.",
  "note": "опускает кулак и улыбается в камеру",
  "audio": false
 },
 {
  "id": "but_007",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Неплохо держишься для деда, которого сорок лет держали в морозилке.",
  "say": "Неплохо держишься для деда, которого сорок лет держали в морозилке.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_005",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Ты ещё кто такой?",
  "say": "Ты ещё кто такой?",
  "note": "",
  "audio": false
 },
 {
  "id": "but_008",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Билли Бутчер. Человек, который ненавидит Хоумлендера сильнее, чем ты.",
  "say": "Билли Бутчер. Человек, который ненавидит Хоумлендера сильнее, чем ты.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_006",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Сомневаюсь, приятель. У меня список. Те, кто сдал меня русским. Мои старые «друзья». Все до единого.",
  "say": "Сомневаюсь, приятель. У меня список. Те, кто сдал меня русским. Мои старые «друзья». Все до единого.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_009",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Я помогу найти каждого. Слово даю.",
  "say": "Я помогу найти каждого. Слово даю.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_007",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "…Но?",
  "say": "…Но?",
  "note": "",
  "audio": false
 },
 {
  "id": "but_010",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Но сначала — Хоумлендер. Твой сынок.",
  "say": "Но сначала — Хоумлендер. Твой сынок.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_008",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "*усмехается* Сначала пацан в плаще. Потом — мои.",
  "say": "Сначала пацан в плаще. Потом — мои.",
  "note": "усмехается",
  "audio": false
 },
 {
  "id": "hu_004",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Трое против одного",
  "text": "Билли! Я… я тоже принял Темп-V. Я быстрый. Очень быстрый.",
  "say": "Билли! Я… я тоже принял Темп-V. Я быстрый. Очень быстрый.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_011",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Ну ты и дурак, Хьюи. …Добро пожаловать в команду.",
  "say": "Ну ты и дурак, Хьюи. …Добро пожаловать в команду.",
  "note": "",
  "audio": false
 },
 {
  "id": "news_002",
  "who": "news",
  "speaker": "Ведущий новостей",
  "mission": "Трое против одного",
  "text": "Срочно: Солдатик замечен в Мидтауне!",
  "say": "Срочно: Солдатик замечен в Мидтауне!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_037",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Папочка вернулся. Как трогательно.",
  "say": "Папочка вернулся. Как трогательно.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_009",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Второй раунд, сынок. На этот раз без поддавков.",
  "say": "Второй раунд, сынок. На этот раз без поддавков.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_038",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Ты мне не отец.",
  "say": "Ты мне не отец.",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_010",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Билли! Твоя очередь — он твой!",
  "say": "Билли! Твоя очередь — он твой!",
  "note": "",
  "audio": false
 },
 {
  "id": "but_012",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Привет, дорогуша. Смотри-ка — у меня тоже глазки светятся.",
  "say": "Привет, дорогуша. Смотри-ка — у меня тоже глазки светятся.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_013",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Хьюи! Солдат! Все вместе — сейчас!",
  "say": "Хьюи! Солдат! Все вместе — сейчас!",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_005",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Трое против одного",
  "text": "Привет, Хоумлендер! Сюрприз!",
  "say": "Привет, Хоумлендер! Сюрприз!",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_011",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Все вместе, ребята! Держим его!",
  "say": "Все вместе, ребята! Держим его!",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_012",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Иди-ка сюда, сынок!",
  "say": "Иди-ка сюда, сынок!",
  "note": "",
  "audio": false
 },
 {
  "id": "but_014",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Держи его, Хьюи! ДЕРЖИ!",
  "say": "Держи его, Хьюи! ДЕРЖИ!",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_013",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Не дёргайся, сынок. Это даже не больно… почти.",
  "say": "Не дёргайся, сынок. Это даже не больно… почти.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_039",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Слезь… С МЕНЯ!",
  "say": "Слезь… С МЕНЯ!",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_006",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Трое против одного",
  "text": "Он слишком сильный, Билли!",
  "say": "Он слишком сильный, Билли!",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_014",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "Ещё чуть-чуть… и вся твоя V сгорит к чертям!",
  "say": "Ещё чуть-чуть… и вся твоя V сгорит к чертям!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_040",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Р-Р-Р-А-А-А-А!",
  "say": "Р-Р-Р-А-А-А-А!",
  "note": "",
  "audio": false
 },
 {
  "id": "sb_015",
  "who": "sb",
  "speaker": "Солдатик",
  "mission": "Трое против одного",
  "text": "…Чёрт. Ещё секунда — и всё.",
  "say": "…Чёрт. Ещё секунда — и всё.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_015",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Упустили. Мать твою, упустили!",
  "say": "Упустили. Мать твою, упустили!",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_007",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Трое против одного",
  "text": "Что теперь, Билли?",
  "say": "Что теперь, Билли?",
  "note": "",
  "audio": false
 },
 {
  "id": "but_016",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Трое против одного",
  "text": "Теперь он сам придёт за нами. Встретим его. В Белом доме.",
  "say": "Теперь он сам придёт за нами. Встретим его. В Белом доме.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_041",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Сначала — Хьюи. Он всегда был самым слабым звеном.",
  "say": "Сначала — Хьюи. Он всегда был самым слабым звеном.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_042",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Хьюи. Маленький, жалкий Хьюи.",
  "say": "Хьюи. Маленький, жалкий Хьюи.",
  "note": "",
  "audio": false
 },
 {
  "id": "hu_008",
  "who": "hu",
  "speaker": "Хьюи",
  "mission": "Трое против одного",
  "text": "Н-не надо… пожалуйста…",
  "say": "Н-не надо… пожалуйста…",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_043",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Тсс. Это будет быстро.",
  "say": "Тсс. Это будет быстро.",
  "note": "",
  "audio": false
 },
 {
  "id": "at_003",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Трое против одного",
  "text": "А-а-а! Плечо! …Хьюи, беги!",
  "say": "А-а-а! Плечо! …Хьюи, беги!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_044",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Эй-Трейн. Ты только что выбрал не ту сторону.",
  "say": "Эй-Трейн. Ты только что выбрал не ту сторону.",
  "note": "",
  "audio": false
 },
 {
  "id": "at_004",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Трое против одного",
  "text": "Ох… чёрт.",
  "say": "Ох… чёрт.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_045",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Трое против одного",
  "text": "Самый быстрый человек на свете. Был.",
  "say": "Самый быстрый человек на свете. Был.",
  "note": "",
  "audio": false
 },
 {
  "id": "mil_001",
  "who": "mil",
  "speaker": "Командир",
  "mission": "Финал: Белый дом",
  "text": "*рация* Всем постам: Белый дом окружён. Без приказа не входить.",
  "say": "Всем постам: Белый дом окружён. Без приказа не входить.",
  "note": "рация",
  "audio": false
 },
 {
  "id": "mil_002",
  "who": "mil",
  "speaker": "Командир",
  "mission": "Финал: Белый дом",
  "text": "Держать позиции! Без приказа не стрелять!",
  "say": "Держать позиции! Без приказа не стрелять!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_046",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Тихо, Билли. Тихо… Ты так долго этого ждал.",
  "say": "Тихо, Билли. Тихо… Ты так долго этого ждал.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_017",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "*хрипит* …иди… ты… к чёрту…",
  "say": "…иди… ты… к чёрту…",
  "note": "хрипит",
  "audio": false
 },
 {
  "id": "hl_047",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "…Пусть смотрят.",
  "say": "…Пусть смотрят.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_018",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Ну всё, дорогуша. Ты сам напросился.",
  "say": "Ну всё, дорогуша. Ты сам напросился.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_048",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Ты правда думал, что сможешь меня остановить, Билли?",
  "say": "Ты правда думал, что сможешь меня остановить, Билли?",
  "note": "",
  "audio": false
 },
 {
  "id": "but_019",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Это за Бекку, ублюдок!",
  "say": "Это за Бекку, ублюдок!",
  "note": "",
  "audio": false
 },
 {
  "id": "at_005",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Финал: Белый дом",
  "text": "…Да ну на фиг. Как?!",
  "say": "…Да ну на фиг. Как?!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_049",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Я — Хоумлендер.",
  "say": "Я — Хоумлендер.",
  "note": "",
  "audio": false
 },
 {
  "id": "at_006",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Финал: Белый дом",
  "text": "Ладно, ладно. Слушай… Пацаны прячутся в порту. Я тебе ничего не говорил.",
  "say": "Ладно, ладно. Слушай… Пацаны прячутся в порту. Я тебе ничего не говорил.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_050",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Самый быстрый клоун в мире.",
  "say": "Самый быстрый клоун в мире.",
  "note": "",
  "audio": false
 },
 {
  "id": "at_007",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Финал: Белый дом",
  "text": "*себе под нос, отвернувшись* …Иди нахер.",
  "say": "…Иди нахер.",
  "note": "себе под нос, отвернувшись",
  "audio": false
 },
 {
  "id": "hl_051",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Ты что мне сейчас сказал?",
  "say": "Ты что мне сейчас сказал?",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_052",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "ТЫ ЧТО МНЕ СЕЙЧАС СКАЗАЛ?!",
  "say": "ТЫ ЧТО МНЕ СЕЙЧАС СКАЗАЛ?!",
  "note": "",
  "audio": false
 },
 {
  "id": "at_008",
  "who": "at",
  "speaker": "Эй-Трейн",
  "mission": "Финал: Белый дом",
  "text": "Блин… прости! Прости, прости!",
  "say": "Блин… прости! Прости, прости!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_053",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "ПОВТОРИ. ПОВТОРИ!",
  "say": "ПОВТОРИ. ПОВТОРИ!",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_054",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Американцы. Я обращаюсь к вам из Овального кабинета.",
  "say": "Американцы. Я обращаюсь к вам из Овального кабинета.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_055",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Всю жизнь я защищал вас. Теперь пришло время вести вас.",
  "say": "Всю жизнь я защищал вас. Теперь пришло время вести вас.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_056",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Больше никаких лжецов в костюмах. Только я. И правда…",
  "say": "Больше никаких лжецов в костюмах. Только я. И правда…",
  "note": "",
  "audio": false
 },
 {
  "id": "but_020",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Батя дома.",
  "say": "Батя дома.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_057",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Я уж думал, ты забыл про наш уговор.",
  "say": "Я уж думал, ты забыл про наш уговор.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_021",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Выжженная земля.",
  "say": "Выжженная земля.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_058",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Райан? Ты… с НИМИ?",
  "say": "Райан? Ты… с НИМИ?",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_059",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Райан. Ты же мой сын. Встань рядом со мной.",
  "say": "Райан. Ты же мой сын. Встань рядом со мной.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_022",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Ты сделал больно собственному сыну. А теперь — по-взрослому.",
  "say": "Ты сделал больно собственному сыну. А теперь — по-взрослому.",
  "note": "",
  "audio": false
 },
 {
  "id": "hl_060",
  "who": "hl",
  "speaker": "Хоумлендер",
  "mission": "Финал: Белый дом",
  "text": "Билли. Хватит болтать.",
  "say": "Билли. Хватит болтать.",
  "note": "",
  "audio": false
 },
 {
  "id": "but_023",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Ты всего лишь пацан в плаще, которого никто не любил!",
  "say": "Ты всего лишь пацан в плаще, которого никто не любил!",
  "note": "",
  "audio": false
 },
 {
  "id": "but_024",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Я тебя не отпущу, слышишь?! Никогда!",
  "say": "Я тебя не отпущу, слышишь?! Никогда!",
  "note": "",
  "audio": false
 },
 {
  "id": "but_025",
  "who": "but",
  "speaker": "Бутчер",
  "mission": "Финал: Белый дом",
  "text": "Кх-х… Ну давай. Чего ждёшь?",
  "say": "Кх-х… Ну давай. Чего ждёшь?",
  "note": "",
  "audio": false
 },
 {
  "id": "ash_015",
  "who": "ash",
  "speaker": "Эшли (Vought)",
  "mission": "Финал: Белый дом",
  "text": "*в наушнике* Хоумлендер, на тебя смотрят все камеры страны. И Райан тоже. Решай.",
  "say": "Хоумлендер, на тебя смотрят все камеры страны. И Райан тоже. Решай.",
  "note": "в наушнике",
  "audio": false
 }
]